{
  "name": "renovation-metbach",
  "version": "1.0.0",
  "private": true,
  "description": "Site statique de Rénovation Metbach",
  "scripts": {
    "build": "python3 scripts/build-conseils.py && node scripts/build-css.cjs && node scripts/build-site.cjs",
    "check:seo": "python3 scripts/check-seo.py",
    "preview": "python3 scripts/preview.py",
    "check:contact": "node scripts/check-contact.mjs",
    "images:apply": "python3 scripts/apply-responsive-images.py",
    "indexnow": "python3 scripts/indexnow-submit.py",
    "check:content": "python3 scripts/build-conseils.py --check"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "lucide": "0.469.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17"
  }
}
